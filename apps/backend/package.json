{
  "name": "@sukha/backend",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:migrate": "wrangler d1 migrations apply sukha --local",
    "check": "wrangler types && tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "db:seed": "wrangler d1 execute sukha --local --file seed.sql",
    "deploy:staging": "wrangler deploy --env staging",
    "db:migrate:staging": "wrangler d1 migrations apply sukha-staging --env staging --remote",
    "db:migrate:prod": "wrangler d1 migrations apply sukha --remote",
    "admin:crear": "node scripts/crear-admin.ts",
    "db:seed:staging": "wrangler d1 execute sukha-staging --env staging --remote --file seed.sql",
    "e2e": "node scripts/e2e.ts",
    "db:backup": "wrangler d1 export sukha --remote --output backups/sukha.sql",
    "db:backup:staging": "wrangler d1 export sukha-staging --env staging --remote --output backups/sukha-staging.sql"
  },
  "dependencies": {
    "@sentry/cloudflare": "^11.7.0",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.13",
    "resend": "^6.32.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "typescript": "^7.0.2",
    "vitest": "^5.0.4",
    "wrangler": "^4.149.0"
  }
}
