{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "sukha-frontend",
  "main": "@astrojs/cloudflare/entrypoints/server",
  "compatibility_date": "2026-10-06",
  "compatibility_flags": ["global_fetch_strictly_public"],
  "assets": { "directory": "./dist", "binding": "ASSETS" },
  "observability": { "enabled": true },

  // Nivel superior = producción. El backend no tiene URL pública: /api/* se le reenvía por este binding.
  "services": [{ "binding": "API", "service": "sukha-backend" }],
  // Las fotos se sirven desde acá, cerca de quien mira (el backend corre lejos, junto a la base). Solo lectura.
  "kv_namespaces": [{ "binding": "IMAGENES", "id": "48ce71de7b9c4c62bb1ab370c658b4be" }],
  "routes": [{ "pattern": "sukhaind.com.ar", "custom_domain": true }],

  "env": {
    "staging": {
      "services": [{ "binding": "API", "service": "sukha-backend-staging" }],
      "kv_namespaces": [{ "binding": "IMAGENES", "id": "9b7b6e6c4fa64a08938158c20e6441b8" }],
      "routes": [],
      "workers_dev": true
    }
  }
}
