{
  "name": "@sukha/frontend",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "check": "tsc --noEmit -p tsconfig.islas.json",
    "e2e": "node scripts/e2e-tienda.mjs",
    "build": "wrangler types && astro build",
    "deploy": "node scripts/sin-demo.mjs && npm run build && wrangler deploy",
    "deploy:staging": "node scripts/sin-demo.mjs && wrangler types && astro build --mode staging && wrangler deploy"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.3.4",
    "@astrojs/preact": "^6.0.6",
    "@lucide/astro": "^1.56.0",
    "@nanostores/persistent": "^1.3.5",
    "@nanostores/preact": "^1.1.1",
    "astro": "^7.3.8",
    "cropperjs": "^1.6.2",
    "flatpickr": "^4.6.13",
    "lucide-preact": "^1.57.0",
    "maplibre-gl": "^6.16.0",
    "nanostores": "^1.5.5",
    "preact": "^10.29.8",
    "sortablejs": "^1.15.7"
  },
  "devDependencies": {
    "@tailwindcss/forms": "^0.5.11",
    "@tailwindcss/vite": "^4.3.3",
    "@types/sortablejs": "^1.15.9",
    "tailwindcss": "^4.3.3",
    "wrangler": "^4.149.0"
  }
}
