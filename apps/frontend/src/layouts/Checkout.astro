---
// Layout del checkout: cabecera mínima (solo el logo y "compra segura"), sin menú ni buscador, para que nada distraiga.
import '../styles/tienda.css';
import { Lock } from '@lucide/astro';
import Logo from '../components/tienda/Logo.astro';
import { datosDeLaTienda } from '../lib/tienda';

interface Props {
  titulo: string;
}
const { titulo } = Astro.props;
const { tienda } = await datosDeLaTienda(Astro.request);
---

<!doctype html>
<html lang="es-AR">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,300..700;1,9..144,300..700&family=Figtree:wght@300..700&display=swap" />
		<title>{titulo} | {tienda.titulo}</title>
		<meta name="robots" content="noindex" />
		<link rel="icon" href={tienda.favicon ?? "/favicon.svg"} />
	</head>
	<body class="flex min-h-screen flex-col">
		<header class="border-linea border-b">
			<div class="mx-auto grid h-16 w-full max-w-[1200px] grid-cols-[1fr_auto_1fr] items-center px-4 md:h-[84px] md:px-10">
				<a href="/carrito" class="text-suave text-sm hover:underline">← <span class="max-sm:sr-only">Volver al carrito</span></a>
				<Logo logo={tienda.logo} />
				<p class="text-suave flex items-center justify-end gap-2 text-sm max-md:sr-only"><Lock class="size-4" aria-hidden="true" />Compra segura</p>
			</div>
		</header>
		{tienda.vacaciones && <div class="bg-texto text-fondo px-4 py-[11px] text-center text-xs" role="status">Estamos de vacaciones: no tomamos pedidos por ahora. {tienda.vacaciones.mensaje}</div>}
		<main class="mx-auto w-full max-w-[1200px] flex-1 px-4 py-8 md:px-10 md:py-14">
			<h1 class="mb-8 text-[34px] leading-tight md:mb-10 md:text-[44px]">Finalizar compra</h1>
			<slot />
		</main>
		<footer class="border-linea text-suave border-t py-6 text-center text-xs">
			<p class="contenedor flex flex-wrap justify-center gap-x-5 gap-y-1">
				<a href="/cambios-y-devoluciones" class="underline">Cambios y devoluciones</a>
				<a href="/contacto" class="underline">Contacto</a>
				<a href="/arrepentimiento" class="underline">Botón de arrepentimiento</a>
			</p>
		</footer>
	</body>
</html>
