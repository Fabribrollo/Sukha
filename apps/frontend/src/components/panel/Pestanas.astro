---
// Pestañas de una página (Envíos, Configuración): en el celular, una fila que se desplaza de costado; con `lateral`, en
// escritorio pasan a un submenú en columna. Cada pestaña muestra su <section data-panel="id">: ver scripts/pestanas.ts.
// Una pestaña con `href` es un link común a otra pantalla.
interface Props {
  etiqueta: string;
  pestanas: { id: string; nombre: string; icono: any; href?: string }[];
  inicial: string;
  lateral?: boolean;
}
const { etiqueta, pestanas, inicial, lateral = false } = Astro.props;
---

<nav data-pestanas data-inicial={inicial} aria-label={etiqueta} class:list={['flex gap-1 overflow-x-auto rounded-xl bg-gray-100 p-1', lateral ? 'lg:flex-col lg:self-start lg:bg-transparent lg:p-0' : 'sm:w-fit']}>
	{pestanas.map((p) => {
		const Icono = p.icono;
		return (
			<a
				href={p.href ?? `#${p.id}`}
				data-pestana={p.href ? undefined : ''}
				aria-current={!p.href && p.id === inicial ? 'page' : undefined}
				class:list={[
					'flex shrink-0 items-center gap-1.5 rounded-lg px-2 py-1.5 sm:gap-2 sm:px-3 text-sm font-medium whitespace-nowrap text-gray-500 transition hover:text-gray-700',
					'aria-[current=page]:shadow-theme-xs aria-[current=page]:bg-white aria-[current=page]:text-gray-900',
					lateral && 'lg:py-2.5 lg:hover:bg-gray-100 lg:aria-[current=page]:bg-brand-50 lg:aria-[current=page]:text-brand-700 lg:aria-[current=page]:shadow-none',
				]}
			>
				<Icono class="size-4 shrink-0" aria-hidden="true" />{p.nombre}
			</a>
		);
	})}
</nav>

<script>
	import '../../scripts/pestanas';
</script>
