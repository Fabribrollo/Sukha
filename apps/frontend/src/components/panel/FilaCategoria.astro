---
// Una fila de la lista de categorías: asa para arrastrar, nombre, interruptor de visibilidad y lápiz para editar.
// Los eventos los maneja `scripts/categorias.ts`; el <li> que la contiene lleva `data-id` y `data-oculta`.
import { GripVertical, Pencil } from '@lucide/astro';
import Insignia from './Insignia.astro';

interface Props {
  categoria: { id: number; nombre: string; padreId: number | null; guiaTalles: string | null; activa: number };
  tieneHijas?: boolean;
  // Cantidad de subcategorías, para mostrarla en las principales.
  hijas?: number;
}
const { categoria: c, tieneHijas = false, hijas } = Astro.props;
// La guía puede haberse guardado como texto o como tabla: acá se edita como texto.
let guia = '';
if (c.guiaTalles) {
	const valor = JSON.parse(c.guiaTalles);
	guia = typeof valor === 'string' ? valor : JSON.stringify(valor, null, 2);
}
const datos = JSON.stringify({ id: c.id, nombre: c.nombre, padreId: c.padreId, guia, activa: c.activa === 1, tieneHijas });
---

<div class="flex items-center gap-2 px-3 py-2.5 sm:px-4">
	<button type="button" data-asa class="btn-icono cursor-grab touch-none active:cursor-grabbing" title="Arrastrar para ordenar" aria-label={`Ordenar ${c.nombre}: arrastrá o usá las flechas arriba y abajo`}>
		<GripVertical class="size-5" aria-hidden="true" />
	</button>
	<span class="min-w-0 flex-1 truncate text-sm font-medium text-gray-800 group-data-[oculta=true]/item:text-gray-400">{c.nombre}</span>
	{hijas !== undefined && <span class="text-theme-xs hidden text-gray-500 sm:inline">{hijas === 0 ? 'Sin subcategorías' : `${hijas} ${hijas === 1 ? 'subcategoría' : 'subcategorías'}`}</span>}
	<span class="hidden group-data-[oculta=true]/item:inline-flex"><Insignia>Oculta</Insignia></span>
	<label class="flex cursor-pointer items-center select-none" title="Visible en la tienda">
		<input type="checkbox" data-activa checked={c.activa === 1} class="peer sr-only" />
		<span class="sr-only">{`${c.nombre} visible en la tienda`}</span>
		<span class="peer-checked:bg-brand-500 peer-focus-visible:ring-brand-500/30 relative h-6 w-11 shrink-0 rounded-full bg-gray-200 transition peer-focus-visible:ring-3 after:absolute after:top-0.5 after:left-0.5 after:size-5 after:rounded-full after:bg-white after:shadow-theme-sm after:transition-transform peer-checked:after:translate-x-5" aria-hidden="true"></span>
	</label>
	<button type="button" data-editar={datos} class="btn-icono" title="Editar" aria-label={`Editar ${c.nombre}`}>
		<Pencil class="size-5" aria-hidden="true" />
	</button>
	<slot />
</div>
