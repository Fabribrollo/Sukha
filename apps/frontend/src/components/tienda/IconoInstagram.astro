---
// Lucide ya no trae íconos de marcas, así que el de Instagram se dibuja a mano, con el mismo trazo que los demás.
interface Props {
  class?: string;
}
const { class: clase } = Astro.props;
---

<svg class={clase} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
	<rect x="3" y="3" width="18" height="18" rx="5"></rect>
	<circle cx="12" cy="12" r="4"></circle>
	<circle cx="17.5" cy="6.5" r="0.5" fill="currentColor"></circle>
</svg>
