---
// Tarjeta de producto: se usa en la portada, los listados, los relacionados y el 404.
import { ImageOff } from '@lucide/astro';
import { conTransferencia, etiquetasDe, pesos, precioFinal, srcsetFoto, urlFoto, type Tienda, type TarjetaDeProducto } from '../../lib/formato';

interface Props {
  producto: TarjetaDeProducto;
  tienda: Tienda;
  // La primera tarjetas de la página cargan sus fotos de inmediato; el resto, al acercarse.
  prioridad?: boolean;
  // Cuánto ocupa la tarjeta en pantalla, para que el navegador elija el tamaño de foto adecuado.
  sizes?: string;
  // En los listados la tarjeta suma los puntitos de color y el precio con transferencia (diseño de Categoría); en el resto va solo nombre y precio.
  detalle?: boolean;
  // La línea «con transferencia» sin los puntitos de color, solo en escritorio (portada).
  transferenciaEscritorio?: boolean;
}
const { producto: p, tienda, prioridad = false, sizes = '(min-width: 1024px) 25vw, (min-width: 640px) 33vw, 50vw', detalle = false, transferenciaEscritorio = false } = Astro.props;
const cobrado = precioFinal(p);
const agotado = !p.disponible;
const etiquetas = etiquetasDe(p, tienda.ultimasUnidadesUmbral);
const transferencia = agotado || !(detalle || transferenciaEscritorio) ? null : conTransferencia(cobrado, tienda.descuentoTransferenciaPorcentaje);
const colores = detalle ? (p.colores ?? '').split(',').filter(Boolean) : [];
---

<article class="group relative">
	<a href={`/producto/${p.slug}`} class="block">
		<div class="foto-vacia relative aspect-[3/4] overflow-hidden">
			{p.foto ? (
				<img
					src={urlFoto(p.foto, 'mediano')}
					srcset={srcsetFoto(p.foto)}
					sizes={sizes}
					alt=""
					width="900"
					height="1200"
					loading={prioridad ? 'eager' : 'lazy'}
					class:list={['size-full object-cover transition duration-300 group-hover:scale-[1.02]', agotado && 'opacity-60']}
				/>
			) : (
				<ImageOff class="size-8" aria-label="Sin foto" />
			)}
			{etiquetas.length > 0 && (
				<ul class="absolute top-2 left-2 flex flex-col items-start gap-1">
					{etiquetas.map((e) => <li class="bg-fondo text-texto px-1.5 py-0.5 text-[11px] leading-4 tracking-[0.08em] uppercase">{e}</li>)}
				</ul>
			)}
		</div>
		<h3 class="mt-3.5 line-clamp-2 font-sans text-base leading-5">{p.nombre}</h3>
		{colores.length > 1 && (
			<span class="mt-1.5 flex gap-1.5 py-0.5" aria-label={`${colores.length} colores`}>
				{colores.slice(0, 6).map((hex) => <span class="size-3 rounded-full" style={`background:${hex};box-shadow:inset 0 0 0 1px rgb(30 28 25 / 0.15)`}></span>)}
			</span>
		)}
		<p class="mt-1 flex flex-wrap items-baseline gap-x-2.5 text-base">
			{detalle && p.precioOfertaCentavos !== null && <s class="text-suave text-[15px]">{pesos(p.precioCentavos)}</s>}
			<span class:list={[agotado && 'text-suave']}>{pesos(cobrado)}</span>
			{!detalle && p.precioOfertaCentavos !== null && <s class="text-suave text-[15px]">{pesos(p.precioCentavos)}</s>}
		</p>
		{transferencia !== null && <p class:list={['text-suave mt-0.5 text-[13px]', !detalle && 'max-md:hidden']}>{pesos(transferencia)} con transferencia</p>}
	</a>
</article>
