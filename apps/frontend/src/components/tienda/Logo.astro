---
// Logo de la tienda: la imagen subida desde Configuración o, si no hay, el nombre en texto.
interface Props {
  logo?: string | null;
  class?: string;
}
const { logo, class: clase } = Astro.props;
---

<a href="/" class:list={['text-texto inline-flex min-h-11 items-center', !logo && 'text-xl font-normal tracking-[0.42em]', clase]} aria-label="Sukhä, ir al inicio">
	{logo ? <img src={logo} alt="Sukhä" class="h-8 w-auto max-w-[11rem] object-contain md:h-11" /> : 'SUKHÄ'}
</a>
