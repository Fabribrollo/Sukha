---
// Página de información con texto cargado en el panel (o el original de lib/textos.ts si no se editó).
// Se escribe como texto con formato mínimo, nunca como HTML.
import Tienda from '../../layouts/Tienda.astro';
import { datosDeLaTienda } from '../../lib/tienda';
import { textoDe, type ClaveTexto } from '../../lib/textos';
import TextoConFormato from './TextoConFormato.astro';

interface Props {
  titulo: string;
  descripcion: string;
  // Clave del texto en `tienda.contenido`.
  clave: Exclude<ClaveTexto, 'contenido_preguntas_frecuentes'>;
}
const { titulo, descripcion, clave } = Astro.props;
const { tienda } = await datosDeLaTienda(Astro.request);
---

<Tienda titulo={titulo} descripcion={descripcion}>
	<div class="contenedor max-w-2xl py-8 md:py-12">
		<h1 class="mb-6 text-2xl md:text-3xl">{titulo}</h1>
		<TextoConFormato texto={textoDe(clave, tienda.contenido)} tienda={tienda} />
	</div>
</Tienda>
