---
// Grilla de tarjetas de producto: 2 columnas en el celular, 3 en tablet y 4 en escritorio.
import type { Tienda, TarjetaDeProducto } from '../../lib/formato';
import TarjetaProducto from './TarjetaProducto.astro';

interface Props {
  productos: TarjetaDeProducto[];
  tienda: Tienda;
  // Cantidad de columnas en escritorio: 4 en la portada y 3 en los listados con filtros al costado.
  columnas?: 3 | 4;
  // Cuántas de las primeras tarjetas cargan sus fotos de inmediato (las que se ven sin hacer scroll).
  prioridad?: number;
  // Puntitos de color y precio con transferencia en cada tarjeta (listados).
  detalle?: boolean;
  transferenciaEscritorio?: boolean;
}
const { productos, tienda, columnas = 4, prioridad = 0, detalle = false, transferenciaEscritorio = false } = Astro.props;
const sizes = columnas === 4 ? '(min-width: 1024px) 25vw, (min-width: 640px) 33vw, 50vw' : '(min-width: 1024px) 22vw, (min-width: 640px) 33vw, 50vw';
---

<ul class:list={['grid grid-cols-2 gap-x-3 gap-y-8 sm:grid-cols-3 md:gap-x-5', columnas === 4 ? 'lg:grid-cols-4' : 'lg:grid-cols-3 md:gap-x-6 md:gap-y-14']}>
	{productos.map((p, i) => <li><TarjetaProducto producto={p} tienda={tienda} prioridad={i < prioridad} sizes={sizes} detalle={detalle} transferenciaEscritorio={transferenciaEscritorio} /></li>)}
</ul>
