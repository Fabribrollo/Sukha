---
// Pie de la tienda, como en el diseño: fondo de tinta, suscripción a novedades, columnas Comprar · Ayuda · Sukhä y, abajo, los datos
// del comercio con lo que exige la ley (Res. 270/2020 y Disp. 954/2025). En el celular quedan la suscripción y la lista de ayuda.
import { MessageCircle } from '@lucide/astro';
import { enlaceWhatsapp, type Filtros, type Tienda } from '../../lib/formato';
import Newsletter from './Newsletter.tsx';

interface Props {
  tienda: Tienda;
  filtros: Filtros;
  // La portada ya trae la suscripción: acá no se repite.
  sinNewsletter?: boolean;
}
const { tienda, filtros, sinNewsletter = false } = Astro.props;
// En la ficha el botón flotante de WhatsApp no va (la compra ya tiene su enlace) y el checkout no usa este pie.
const conWhatsapp = tienda.whatsapp && !Astro.url.pathname.startsWith('/producto/');
// Datos del comercio que exige la ley, en una línea; lo que todavía no se cargó no se muestra.
const comercio: Partial<Tienda['comercio']> = tienda.comercio ?? {};
const datosComercio = [comercio.razonSocial, comercio.cuit && `CUIT ${comercio.cuit}`, comercio.condicionFiscal, comercio.domicilio, tienda.emailContacto].filter(Boolean).join(' · ');
const titulo = 'mb-1.5 text-xs font-medium tracking-[0.24em] uppercase';
const link = 'text-fondo hover:opacity-70 text-[15px]';
const coleccion = filtros.colecciones[0];
---

<footer class="bg-texto text-fondo mt-16 md:mt-[120px]">
	<div class="mx-auto flex w-full max-w-[1440px] flex-col gap-10 px-5 pt-12 pb-8 md:gap-16 md:px-14 md:pt-[88px] md:pb-10">
		<div class="grid gap-10 md:grid-cols-[2fr_1fr_1fr_1fr] md:gap-12">
			{!sinNewsletter ? (
				<div class="flex max-w-[420px] flex-col gap-4">
					<h2 class="font-serif text-[26px] md:text-[32px]">Novedades por email</h2>
					<Newsletter client:visible oscuro />
				</div>
			) : (
				<div class="max-md:hidden"></div>
			)}

			<nav aria-label="Comprar" class="flex flex-col gap-3 max-md:hidden">
				<h2 class={titulo}>Comprar</h2>
				<a href="/productos" class={link}>Nuevo</a>
				<a href="/productos" class={link}>Prendas</a>
				{coleccion && <a href="/colecciones" class={link}>Colecciones</a>}
				<a href="/ofertas" class={link}>Ofertas</a>
			</nav>

			<nav aria-label="Ayuda" class="flex flex-col md:gap-3">
				<h2 class={`${titulo} max-md:sr-only`}>Ayuda</h2>
				<ul class="flex flex-col max-md:border-t max-md:border-fondo/20 md:gap-3">
					<li class="max-md:border-fondo/20 max-md:border-b"><a href="/pedido/buscar" class={`${link} block max-md:py-3.5`}>Buscar mi pedido</a></li>
					<li class="max-md:border-fondo/20 max-md:border-b"><a href="/cambios-y-devoluciones" class={`${link} block max-md:py-3.5`}>Cambios y devoluciones</a></li>
					<li class="max-md:border-fondo/20 max-md:border-b"><a href="/preguntas-frecuentes" class={`${link} block max-md:py-3.5`}>Preguntas frecuentes</a></li>
					<li class="max-md:border-fondo/20 md:hidden max-md:border-b"><a href="/contacto" class={`${link} block max-md:py-3.5`}>Contacto</a></li>
					{/* Obligatorio por ley (Disp. 954/2025): en todas las páginas y destacado. */}
					<li class="max-md:border-fondo/20 max-md:border-b"><a href="/arrepentimiento" class={`${link} block max-md:py-3.5`}>Botón de arrepentimiento</a></li>
				</ul>
			</nav>

			<nav aria-label="Sukhä" class="flex flex-col gap-3 max-md:hidden">
				<h2 class={titulo}>Sukhä</h2>
				<a href="/quienes-somos" class={link}>Quiénes somos</a>
				<a href="/contacto" class={link}>Contacto</a>
				{tienda.instagram && <a href={`https://instagram.com/${tienda.instagram}`} rel="noopener" class={link}>Instagram</a>}
				{tienda.whatsapp && <a href={enlaceWhatsapp(tienda.whatsapp)} rel="noopener" class={link}>WhatsApp</a>}
			</nav>
		</div>

		<div class="border-fondo/20 flex flex-col gap-4 border-t pt-6 text-[13px] md:flex-row md:items-start md:justify-between md:gap-10">
			<div class="text-fondo/70 flex items-start gap-4 leading-relaxed">
				<div class="space-y-1.5">
					{datosComercio && <p>{datosComercio}</p>}
					{tienda.datosLegales && <p class="whitespace-pre-line">{tienda.datosLegales}</p>}
					<p class="flex flex-wrap gap-x-4">
						<a href="/terminos" class="underline">Términos y condiciones</a>
						<a href="/privacidad" class="underline">Política de privacidad</a>
					</p>
					{/* Texto y destino que fija la Res. 270/2020. */}
					<p><a href="https://www.argentina.gob.ar/produccion/defensadelconsumidor/formulario" rel="noopener" target="_blank" class="underline">Defensa de las y los consumidores. Para reclamos ingrese aquí</a></p>
					<p>© {new Date().getFullYear()} {tienda.titulo}</p>
				</div>
				{/* QR de Data Fiscal (ARCA, formulario 960): la imagen y el link son los oficiales. */}
				{comercio.dataFiscalUrl && (
					<a href={comercio.dataFiscalUrl} target="_blank" rel="noopener" class="shrink-0" title="Data Fiscal">
						<img src="https://www.afip.gob.ar/images/f960/DATAWEB.jpg" alt="Data Fiscal" loading="lazy" class="h-[62px] w-auto" />
					</a>
				)}
			</div>
			<span class="text-fondo/70 uppercase tracking-[0.42em] max-md:hidden">{tienda.titulo}</span>
		</div>
	</div>
</footer>

{conWhatsapp && (
	<a href={enlaceWhatsapp(tienda.whatsapp)} rel="noopener" target="_blank" class:list={['bg-texto text-fondo border-fondo/30 fixed right-4 bottom-4 z-30 flex size-11 items-center justify-center border hover:opacity-90', Astro.url.pathname === '/' && 'max-md:hidden']} title="Escribinos por WhatsApp" aria-label="Escribinos por WhatsApp">
		<MessageCircle class="size-5" aria-hidden="true" />
	</a>
)}
