---
import BuscarPedido from '../components/tienda/BuscarPedido.tsx';
import TextoConFormato from '../components/tienda/TextoConFormato.astro';
import Tienda from '../layouts/Tienda.astro';
import { textoDe } from '../lib/textos';
import { datosDeLaTienda } from '../lib/tienda';

export const prerender = false;

const { tienda } = await datosDeLaTienda(Astro.request);
---

<Tienda titulo="Botón de arrepentimiento" descripcion="Arrepentite de tu compra sin costo, dentro de los 10 días corridos de recibida.">
	<div class="contenedor max-w-lg py-8 md:py-10">
		<h1 class="mb-2 text-2xl md:text-3xl">Botón de arrepentimiento</h1>
		<TextoConFormato class="text-suave mb-8 text-sm" texto={textoDe('contenido_arrepentimiento', tienda.contenido)} tienda={tienda} />
		<BuscarPedido client:only="preact" modo="arrepentimiento" />
	</div>
</Tienda>
