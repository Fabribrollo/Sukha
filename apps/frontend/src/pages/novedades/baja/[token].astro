---
// Baja del newsletter. Se confirma con un botón (POST) y no al abrir el link: los antivirus y los clientes de correo
// abren los links de los emails por su cuenta, y eso daría de baja a la clienta sin que lo pida.
import { CircleCheck } from '@lucide/astro';
import Tienda from '../../../layouts/Tienda.astro';
import { api } from '../../../lib/api';

export const prerender = false;

let estado: 'pregunta' | 'listo' | 'error' = 'pregunta';
if (Astro.request.method === 'POST') {
	const r = await api(Astro.request, `/api/novedades/baja/${encodeURIComponent(Astro.params.token!)}`, {});
	estado = r.ok ? 'listo' : 'error';
}
---

<Tienda titulo="Baja de novedades" noindex>
	<div class="contenedor max-w-lg py-12 text-center">
		{
			estado === 'listo' ? (
				<>
					<CircleCheck class="text-exito mx-auto mb-3 size-10" aria-hidden="true" />
					<h1 class="text-2xl">Te diste de baja</h1>
					<p class="text-suave mt-2">No vas a recibir más novedades.</p>
					<a href="/" class="boton boton-secundario mt-6">Volver a la tienda</a>
				</>
			) : (
				<>
					<h1 class="text-2xl">¿Querés dejar de recibir novedades?</h1>
					<p class="text-suave mt-2">Dejamos de enviarte emails con lanzamientos y ofertas. Los avisos de tus compras te siguen llegando.</p>
					{estado === 'error' && <p class="text-oferta mt-4 text-sm" role="alert">No pudimos darte de baja. Puede que el link haya vencido: escribinos y lo resolvemos.</p>}
					<form method="post" class="mt-6">
						<button class="boton boton-primario">Darme de baja</button>
					</form>
				</>
			)
		}
	</div>
</Tienda>
