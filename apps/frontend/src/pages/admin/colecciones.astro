---
import CatalogoNav from "../../components/panel/CatalogoNav.astro";
import { Check, ChevronDown, ImageOff, PackagePlus, Plus, Save, Search, Sparkles, Trash2, X } from '@lucide/astro';
import Campo from '../../components/panel/Campo.astro';
import Insignia from '../../components/panel/Insignia.astro';
import Interruptor from '../../components/panel/Interruptor.astro';
import Tarjeta from '../../components/panel/Tarjeta.astro';
import Vacio from '../../components/panel/Vacio.astro';
import Panel from '../../layouts/Panel.astro';
import { api, leer } from '../../lib/api';
import { ESTADOS_PRODUCTO, entero, errorDe, foto, marcado, pesos, txt } from '../../lib/panel';

export const prerender = false;

let error = '';
let altaFallida = false;
if (Astro.request.method === 'POST') {
  const f = await Astro.request.formData();
  const accion = f.get('accion');
  const id = f.get('id');
  let r: Response;
  if (accion === 'borrarColeccion') {
    r = await api(Astro.request, `/api/admin/colecciones/${id}`, undefined, 'DELETE');
    if (r.ok) return Astro.redirect(`${Astro.url.pathname}?ok`, 303);
  } else if (accion === 'coleccionProducto') {
    const coleccionId = f.get('coleccionId');
    const rutaColeccion = `/api/admin/colecciones/${coleccionId}/productos`;
    const elegidos = f.getAll('productoId').map(Number).filter((n) => Number.isInteger(n) && n > 0);
    if (f.get('modo') === 'quitar') r = await api(Astro.request, `${rutaColeccion}/${elegidos[0]}`, undefined, 'DELETE');
    else if (elegidos.length === 0) r = new Response(JSON.stringify({ error: 'Elegí al menos un producto.' }), { status: 400 });
    else r = await api(Astro.request, rutaColeccion, { productoIds: elegidos });
    // Vuelve a la misma colección, abierta, para seguir agregando.
    if (r.ok) return Astro.redirect(`${Astro.url.pathname}?ok&abierta=${coleccionId}#coleccion-${coleccionId}`, 303);
  } else {
    const datos = { nombre: txt(f, 'nombre'), ...(id ? { activa: marcado(f, 'activa') } : {}) };
    r = id ? await api(Astro.request, `/api/admin/colecciones/${id}`, datos, 'PATCH') : await api(Astro.request, '/api/admin/colecciones', datos);
    altaFallida = !id;
    if (r.ok) return Astro.redirect(id ? `${Astro.url.pathname}?ok&abierta=${id}#coleccion-${id}` : `${Astro.url.pathname}?ok`, 303);
  }
  error = await errorDe(r);
}

const [colecciones, productos] = await Promise.all([
  leer<any[]>(Astro.request, '/api/admin/colecciones'),
  leer<any[]>(Astro.request, '/api/admin/productos'),
]);
const abierta = Number(Astro.url.searchParams.get('abierta')) || null;
const ESTADO_COLOR: Record<string, 'verde' | 'gris' | 'ambar'> = { publicado: 'verde', borrador: 'ambar', oculto: 'gris' };
---

<Panel titulo="Colecciones" error={error}>
	<CatalogoNav actual="colecciones" detalle="Agrupá productos para temporadas y campañas." />
	<div class="max-w-6xl">
		<Tarjeta titulo="Colecciones" alRas>
			<Sparkles slot="icono" class="size-5 text-gray-400" aria-hidden="true" />
			<button slot="acciones" type="button" data-alta="alta-coleccion" class="btn btn-primario"><Plus class="size-4" aria-hidden="true" />Nueva colección</button>
			{colecciones.length === 0 && <Vacio texto="Verano, ofertas, nueva temporada…"><Sparkles aria-hidden="true" /></Vacio>}
			<div class="px-5 pt-4"><label class="sr-only" for="buscar-catalogo">Buscar colecciones</label><input id="buscar-catalogo" type="search" class="campo" placeholder="Buscar colecciones…" data-buscar-catalogo /><p data-sin-resultados hidden class="py-3 text-sm text-gray-500">No hay coincidencias.</p></div>
			<ul class="divide-y divide-gray-100">
				{colecciones.map((c) => {
					const dentro = productos.filter((p) => c.productoIds.includes(p.id));
					const disponibles = productos.filter((p) => !c.productoIds.includes(p.id));
					return (
						<li id={`coleccion-${c.id}`} class="coleccion-fila">
							<details class="group" name="coleccion-activa" open={abierta === c.id}>
								<summary class="flex cursor-pointer list-none items-center gap-3 px-5 py-3.5 hover:bg-gray-50 sm:px-6 [&::-webkit-details-marker]:hidden">
									<span class="flex size-12 shrink-0 items-center justify-center overflow-hidden rounded-lg bg-gray-100 text-gray-400">{dentro[0]?.foto ? <img src={foto(dentro[0].foto)!} alt="" class="size-full object-cover" loading="lazy" /> : <Sparkles class="size-5" aria-hidden="true" />}</span><span class="min-w-0 flex-1"><span class="block text-sm font-semibold text-gray-800">{c.nombre}</span><span class="mt-1 block text-xs text-gray-500">{c.activa === 1 ? 'Visible en la tienda' : 'Oculta de la tienda'}</span></span>
									{c.activa !== 1 && <Insignia>Oculta</Insignia>}
									<span class="text-theme-xs text-gray-500">{dentro.length} {dentro.length === 1 ? 'producto' : 'productos'}</span>
									<ChevronDown class="size-4 shrink-0 text-gray-400 transition group-open:rotate-180" aria-hidden="true" />
								</summary>

								<div class="space-y-5 border-t border-gray-100 bg-gray-50/50 px-5 py-4 sm:px-6">
									<form method="post" class="flex flex-wrap items-center gap-3 rounded-xl border border-gray-200 bg-white p-4">
										<input type="hidden" name="accion" value="coleccion" /><input type="hidden" name="id" value={c.id} />
										<input name="nombre" value={c.nombre} required maxlength="60" aria-label="Nombre de la colección" class="campo h-10 w-full sm:flex-1" />
										<Interruptor etiqueta="Visible" nombre="activa" marcado={c.activa === 1} />
										<button class="btn btn-secundario" title="Guardar" aria-label="Guardar colección"><Save class="size-4" aria-hidden="true" />Guardar</button>
										<a href={`/admin/buscadores/coleccion/${c.id}`} class="btn-icono" title="Buscadores y redes" aria-label={`Buscadores y redes de ${c.nombre}`}><Search class="size-5" aria-hidden="true" /></a>
									</form>

									<section aria-label={`Productos de ${c.nombre}`}>
										<h3 class="mb-2 text-sm font-medium text-gray-800">En esta colección ({dentro.length})</h3>
										{dentro.length === 0 && <p class="text-theme-xs text-gray-500">Todavía no tiene productos. Usá «Agregar productos».</p>}
										<ul class="divide-y divide-gray-100 rounded-xl border border-gray-200 bg-white empty:hidden">
											{dentro.map((p) => (
												<li class="flex items-center gap-3 px-3 py-2">
													{foto(p.foto) ? <img src={foto(p.foto)!} alt="" loading="lazy" class="size-10 shrink-0 rounded-lg bg-gray-100 object-cover" /> : <span class="flex size-10 shrink-0 items-center justify-center rounded-lg bg-gray-100 text-gray-400"><ImageOff class="size-4" aria-hidden="true" /></span>}
													<span class="min-w-0 flex-1"><span class="block truncate text-sm text-gray-800">{p.nombre}</span><span class="text-theme-xs block text-gray-500">{p.categoria}</span></span>
													<Insignia color={ESTADO_COLOR[p.estado] ?? 'gris'}>{ESTADOS_PRODUCTO[p.estado] ?? p.estado}</Insignia>
													<form method="post">
														<input type="hidden" name="accion" value="coleccionProducto" /><input type="hidden" name="modo" value="quitar" />
														<input type="hidden" name="coleccionId" value={c.id} /><input type="hidden" name="productoId" value={p.id} />
														<button class="btn-icono hover:bg-error-50 hover:text-error-600" title="Quitar de la colección" aria-label={`Quitar ${p.nombre} de la colección`}><X class="size-4" aria-hidden="true" /></button>
													</form>
												</li>
											))}
										</ul>
									</section>

									<div class="flex flex-wrap items-center justify-between gap-3 rounded-xl border border-dashed border-gray-300 bg-white px-4 py-3">
										<p class="text-theme-sm text-gray-600">{disponibles.length === 0 ? 'Todos tus productos ya están en esta colección.' : `${disponibles.length} ${disponibles.length === 1 ? 'producto disponible' : 'productos disponibles'} para agregar.`}</p>
										<button type="button" data-agregar={JSON.stringify({ id: c.id, nombre: c.nombre, dentro: c.productoIds })} disabled={disponibles.length === 0} class="btn btn-primario"><PackagePlus class="size-4" aria-hidden="true" />Agregar productos</button>
									</div>
									{/* Borrar pide un segundo toque. Las prendas no se borran: solo se deshace la colección. */}
									<details class="group/borrar flex justify-end">
										<summary class="btn btn-peligro-suave group-open/borrar:hidden" aria-label={`Borrar la colección ${c.nombre}`}><Trash2 class="size-4" aria-hidden="true" />Borrar colección</summary>
										<form method="post" class="flex flex-wrap items-center gap-3">
											<p class="text-theme-xs text-gray-500">Las prendas siguen en la tienda.</p>
											<input type="hidden" name="accion" value="borrarColeccion" /><input type="hidden" name="id" value={c.id} />
											<button type="button" data-cancelar-borrado class="btn btn-secundario">Cancelar</button><button class="btn btn-peligro"><Trash2 class="size-4" aria-hidden="true" />¿Borrar?</button>
										</form>
									</details>
								</div>
							</details>
						</li>
					);
				})}
			</ul>
		</Tarjeta>
	</div>

	<dialog id="alta-coleccion" data-abrir={altaFallida ? '' : undefined} class="m-auto w-[calc(100%-2rem)] max-w-md rounded-2xl p-0 backdrop:bg-gray-900/50" aria-labelledby="alta-coleccion-titulo">
		<form method="post" class="space-y-4 p-5 sm:p-6">
			<div class="flex items-center justify-between gap-3">
				<h2 id="alta-coleccion-titulo" class="text-base font-medium text-gray-800">Nueva colección</h2>
				<button type="button" data-cerrar class="btn-icono" title="Cerrar" aria-label="Cerrar"><X class="size-5" aria-hidden="true" /></button>
			</div>
			<input type="hidden" name="accion" value="coleccion" />
			<Campo etiqueta="Nombre" nombre="nombre" required maxlength="60" placeholder="Verano, ofertas…" />
			<button class="btn btn-primario"><Plus class="size-4" aria-hidden="true" />Crear colección</button>
		</form>
	</dialog>

	<dialog id="agregar-productos" class="m-auto h-[90vh] w-[calc(100%-1.5rem)] max-w-5xl overflow-hidden rounded-2xl p-0 backdrop:bg-gray-900/50" aria-labelledby="agregar-productos-titulo">
		<form method="post" class="flex h-full min-h-0 flex-col">
			<input type="hidden" name="accion" value="coleccionProducto" /><input type="hidden" name="modo" value="agregar" /><input type="hidden" name="coleccionId" />
			<header class="flex items-center justify-between gap-3 border-b border-gray-200 px-5 py-4">
				<h2 id="agregar-productos-titulo" class="min-w-0 truncate text-base font-medium text-gray-800">Agregar productos a «<span data-titulo></span>»</h2>
				<button type="button" data-cerrar class="btn-icono" title="Cerrar" aria-label="Cerrar"><X class="size-5" aria-hidden="true" /></button>
			</header>

			<div class="grid grid-cols-2 gap-2 border-b border-gray-200 bg-gray-50/60 px-4 py-3 sm:gap-3 sm:px-5 lg:grid-cols-[1fr_11rem_10rem_11rem]">
				<label class="relative col-span-2 block lg:col-span-1">
					<span class="sr-only">Buscar producto</span>
					<Search class="pointer-events-none absolute top-1/2 left-3.5 size-4 -translate-y-1/2 text-gray-400" aria-hidden="true" />
					<input type="search" data-buscar placeholder="Buscar por nombre…" class="campo h-10 pl-10 text-sm" />
				</label>
				<label><span class="sr-only">Categoría</span>
					<select data-categoria class="campo h-10 text-sm"><option value="">Todas las categorías</option>{[...new Set(productos.map((p) => p.categoria))].sort((a, b) => a.localeCompare(b, 'es')).map((c) => <option value={c}>{c}</option>)}</select>
				</label>
				<label><span class="sr-only">Estado</span>
					<select data-estado class="campo h-10 text-sm"><option value="">Todos los estados</option>{Object.entries(ESTADOS_PRODUCTO).map(([clave, texto]) => <option value={clave}>{texto}</option>)}</select>
				</label>
				<label class="col-span-2 lg:col-span-1"><span class="sr-only">Ordenar por</span>
					<select data-orden class="campo h-10 text-sm">
						<option value="nuevos">Más nuevos</option>
						<option value="az">Nombre A–Z</option>
						<option value="za">Nombre Z–A</option>
						<option value="precio_asc">Menor precio</option>
						<option value="precio_desc">Mayor precio</option>
						<option value="stock">Más stock</option>
					</select>
				</label>
			</div>

			<div class="flex items-center justify-between gap-3 border-b border-gray-100 px-5 py-2.5 text-sm">
				<label class="flex cursor-pointer items-center gap-2.5 text-gray-700 select-none">
					<input type="checkbox" data-todos class="size-4 rounded border-gray-300 accent-[var(--color-brand-500)]" />
					Seleccionar todos los que se ven
				</label>
				<span class="text-theme-xs text-gray-500" data-visibles role="status"></span>
			</div>

			<ul data-productos class="grid min-h-0 flex-1 grid-cols-2 content-start gap-3 overflow-y-auto p-4 sm:grid-cols-4 sm:p-5 lg:grid-cols-5">
				{productos.map((p, i) => (
					<li data-id={p.id} data-nombre={p.nombre.toLowerCase()} data-categoria={p.categoria} data-estado={p.estado} data-precio={p.precioOfertaCentavos ?? p.precioCentavos} data-stock={p.stock} data-posicion={i}>
						<label class="group has-[:checked]:border-brand-500 has-[:checked]:ring-brand-500/30 relative block h-full cursor-pointer overflow-hidden rounded-xl border border-gray-200 bg-white transition hover:border-gray-300 has-[:checked]:ring-2 has-[:focus-visible]:ring-2">
							<input type="checkbox" name="productoId" value={p.id} class="sr-only" />
							<span class="relative block aspect-[3/4] bg-gray-100">
								{foto(p.foto, 'mediano') ? <img src={foto(p.foto, 'mediano')!} alt="" loading="lazy" class="size-full object-cover" /> : <span class="flex size-full items-center justify-center text-gray-400"><ImageOff class="size-6" aria-hidden="true" /></span>}
								<span class="group-has-[:checked]:bg-brand-500 group-has-[:checked]:border-brand-500 absolute top-2 left-2 flex size-6 items-center justify-center rounded-md border-2 border-white bg-gray-900/30 text-white shadow-sm"><Check class="size-4 opacity-0 group-has-[:checked]:opacity-100" aria-hidden="true" /></span>
								<span class="absolute right-2 bottom-2"><Insignia color={ESTADO_COLOR[p.estado] ?? 'gris'}>{ESTADOS_PRODUCTO[p.estado] ?? p.estado}</Insignia></span>
							</span>
							<span class="block space-y-0.5 px-3 py-2.5">
								<span class="block truncate text-sm font-medium text-gray-800">{p.nombre}</span>
								<span class="text-theme-xs block truncate text-gray-500">{p.categoria}</span>
								<span class="text-theme-xs flex items-center justify-between text-gray-600"><span class="font-medium">{pesos(p.precioOfertaCentavos ?? p.precioCentavos)}</span><span>{p.stock} en stock</span></span>
							</span>
						</label>
					</li>
				))}
			</ul>
			<p data-vacio hidden class="flex-1 p-10 text-center text-sm text-gray-500">Ningún producto coincide con lo que buscás.</p>

			<footer class="flex flex-wrap items-center justify-between gap-3 border-t border-gray-200 px-5 py-4">
				<span class="text-sm font-medium text-gray-700" data-seleccionados role="status">Ninguno seleccionado</span>
				<div class="flex items-center gap-2">
					<button type="button" data-cerrar class="btn btn-secundario">Cancelar</button>
					<button class="btn btn-primario" data-confirmar disabled><PackagePlus class="size-4" aria-hidden="true" /><span>Agregar</span></button>
				</div>
			</footer>
		</form>
	</dialog>
</Panel>
<script src="../../scripts/agregar-productos.ts"></script>
<script src="../../scripts/alta.ts"></script>

<script>
const buscar = document.querySelector<HTMLInputElement>('[data-buscar-catalogo]');
const filas = [...document.querySelectorAll<HTMLElement>('li[id^="coleccion-"]')];
const normal = (s: string) => s.normalize('NFD').replace(/[\u0300-\u036f]/g, '').toLowerCase();
buscar?.addEventListener('input', () => {
 const q = normal(buscar.value.trim());
 filas.forEach((fila) => { fila.hidden = !normal(fila.querySelector('summary')?.textContent ?? '').includes(q); });
 const vacio = document.querySelector<HTMLElement>('[data-sin-resultados]');
 if (vacio) vacio.hidden = filas.some((f) => !f.hidden);
});
</script>

<script>
document.querySelectorAll('[data-cancelar-borrado]').forEach((boton) => boton.addEventListener('click', () => boton.closest('details')?.removeAttribute('open')));
</script>
