---
import { Search, Camera, CircleCheck, CircleDashed, Copy, Eye, EyeOff, History, ImagePlus, Layers, PackagePlus, Pause, Crop, Play, Plus, SlidersHorizontal, Banknote, FolderTree, Star, Store, Tag, Trash2, GripVertical } from '@lucide/astro';
import BarraGuardado from '../../../components/panel/BarraGuardado.astro';
import Campo from '../../../components/panel/Campo.astro';
import DatosProducto from '../../../components/panel/DatosProducto.astro';
import Insignia from '../../../components/panel/Insignia.astro';
import Interruptor from '../../../components/panel/Interruptor.astro';
import SeoCampos from '../../../components/panel/SeoCampos.astro';
import Tarjeta from '../../../components/panel/Tarjeta.astro';
import Vacio from '../../../components/panel/Vacio.astro';
import Panel from '../../../layouts/Panel.astro';
import { api, leer } from '../../../lib/api';
import { ESTADOS_PRODUCTO, categoriasParaElegir, MOVIMIENTOS, centavos, enCampo, entero, errorDe, fecha, foto, marcado, txt } from '../../../lib/panel';

export const prerender = false;

const id = Astro.params.id;
const ruta = `/api/admin/productos/${id}`;
let error = '';
let aviso = '';

if (Astro.request.method === 'POST') {
  const f = await Astro.request.formData();
  const accion = f.get('accion');
  let r: Response | null = null;

  if (accion === 'datos') {
    const precio = centavos(f, 'precio');
    const oferta = centavos(f, 'oferta');
    if (!precio || Number.isNaN(oferta)) error = 'Revisá los precios: van en pesos, por ejemplo 18500 o 18.500,50.';
    else {
      r = await api(Astro.request, ruta, {
        nombre: txt(f, 'nombre'),
        categoriaId: entero(f, 'categoriaId'),
        descripcion: txt(f, 'descripcion'),
        materialIds: f.getAll('material').map(Number),
        marcaId: entero(f, 'marcaId') ?? null,
        cuidados: txt(f, 'cuidados'),
        precioCentavos: precio,
        precioOfertaCentavos: oferta,
        pesoGramos: entero(f, 'pesoGramos'),
        destacado: marcado(f, 'destacado'),
        coleccionIds: f.getAll('coleccion').map(Number),
      }, 'PATCH');
    }
  } else if (accion === 'seo') {
    r = await api(Astro.request, ruta, { slug: txt(f, 'slug') ?? undefined, seoTitulo: txt(f, 'seoTitulo'), seoDescripcion: txt(f, 'seoDescripcion'), seoImagen: txt(f, 'seoImagen') }, 'PATCH');
  } else if (accion === 'estado') {
    r = await api(Astro.request, ruta, { estado: f.get('estado') }, 'PATCH');
  } else if (accion === 'duplicar') {
    r = await api(Astro.request, `${ruta}/duplicar`, {});
    if (r.ok) return Astro.redirect(`/admin/productos/${((await r.json()) as any).id}?ok`, 303);
  } else if (accion === 'variante') {
    r = await api(Astro.request, `${ruta}/variantes`, { talleId: entero(f, 'talleId'), colorId: entero(f, 'colorId'), stock: entero(f, 'stock') ?? 0 });
  } else if (accion === 'activa') {
    r = await api(Astro.request, `/api/admin/variantes/${f.get('varianteId')}`, { activa: f.get('valor') === '1' }, 'PATCH');
  } else if (accion === 'borrarVariante') {
    r = await api(Astro.request, `/api/admin/variantes/${f.get('varianteId')}`, undefined, 'DELETE');
    // Con ventas no se borra (rompería el historial): queda pausada, y se avisa.
    if (r.ok && ((await r.clone().json()) as any).resultado === 'pausada') {
      aviso = 'Esa variante ya tuvo ventas, así que no se borró para no perder el historial: quedó pausada y deja de venderse.';
      r = undefined as any;
    }
  } else if (accion === 'stock') {
    // Se edita el número de stock de la fila: se manda la diferencia como «ajuste», así queda en el historial y no pisa ventas hechas mientras tanto.
    const diferencia = (entero(f, 'stockNuevo') ?? NaN) - (entero(f, 'stockActual') ?? NaN);
    if (!Number.isFinite(diferencia)) error = 'El stock tiene que ser un número entero, 0 o más.';
    else if (diferencia !== 0) r = await api(Astro.request, `/api/admin/variantes/${f.get('varianteId')}/stock`, { tipo: 'ajuste', cantidad: diferencia, nota: 'Ajuste desde la ficha del producto' });
  } else if (accion === 'foto') {
    r = await api(Astro.request, `/api/admin/imagenes/${f.get('imagenId')}`, { colorId: entero(f, 'colorId') ?? null }, 'PATCH');
  } else if (accion === 'borrarFoto') {
    r = await api(Astro.request, `/api/admin/imagenes/${f.get('imagenId')}`, undefined, 'DELETE');
  }

  if (r) error = await errorDe(r);
  // La barra de guardado manda cada tarjeta por separado y pide JSON, para decir cuál falló sin recargar.
  if (Astro.request.headers.get('accept') === 'application/json') return Response.json(error ? { error } : { ok: true }, { status: error ? 400 : 200 });
  if (r?.ok) return Astro.redirect(`${Astro.url.pathname}?ok`, 303);
}

const respuesta = await api(Astro.request, ruta);
if (respuesta.status === 404) return Astro.redirect('/admin/productos');
const p = (await respuesta.json()) as any;
const [categorias, colecciones, opciones, sugeridos] = await Promise.all([
  leer<any[]>(Astro.request, '/api/admin/categorias'),
  leer<any[]>(Astro.request, '/api/admin/colecciones'),
  leer<{ talles: any[]; colores: any[]; marcas: any[]; materiales: any[] }>(Astro.request, '/api/admin/opciones'),
  leer<{ cuidados: string[] }>(Astro.request, '/api/admin/productos/sugerencias'),
]);
// Opciones de cuidados: lo ya usado en otros productos, más el valor actual de este.
const conActual = (lista: string[], actual: string | null) => (actual && !lista.includes(actual) ? [actual, ...lista] : lista);
// El libro de movimientos se muestra de a una variante, con ?movimientos=ID.
const verMovimientos = Number(Astro.url.searchParams.get('movimientos')) || null;
const movimientos = verMovimientos ? await leer<any[]>(Astro.request, `/api/admin/variantes/${verMovimientos}/movimientos`) : [];
const stockTotal = p.variantes.filter((v: any) => v.activa).reduce((s: number, v: any) => s + v.stock, 0);
const colorDe = (colorId: number | null) => opciones.colores.find((c) => c.id === colorId);
// Las fotos se muestran según el color que elige la clienta: las opciones son los colores de las variantes de este producto.
const variantesParaFoto = [...new Set(p.variantes.map((v: any) => v.colorId).filter(Boolean))].map((colorId) => ({
  id: colorId as number,
  texto: colorDe(colorId as number)?.nombre ?? 'Color',
}));
// Si una foto quedó con un color que el producto ya no tiene, se conserva como opción para no perderla sin querer.
const opcionesFoto = (actual: number | null) =>
  actual && !variantesParaFoto.some((v) => v.id === actual) ? [...variantesParaFoto, { id: actual, texto: `${colorDe(actual)?.nombre ?? 'Color'} (sin variantes)` }] : variantesParaFoto;
const publicado = p.estado === 'publicado';
// Lo que muestra Google si no se escribe una descripción propia (lo mismo que arma la ficha de la tienda).
const descripcionAutomatica = (p.descripcion ?? '').replace(/\s+/g, ' ').trim().slice(0, 155) || `${p.nombre} en Sukhä. Envíos a todo el país.`;
const colorEstado: Record<string, any> = { publicado: 'verde', borrador: 'ambar', oculto: 'gris' };
// Lo que hace falta para poder publicar.
const requisitos = [
  { listo: stockTotal > 0, texto: 'Variante con stock' },
  { listo: p.imagenes.length > 0, texto: 'Al menos una foto' },
];
---

<Panel titulo={p.nombre} error={error} aviso={aviso} volver={{ href: '/admin/productos', texto: 'Productos' }}>
	<Fragment slot="acciones">
		<Insignia color={colorEstado[p.estado]}>{ESTADOS_PRODUCTO[p.estado]}</Insignia>
		<form method="post">
			<input type="hidden" name="accion" value="estado" /><input type="hidden" name="estado" value={publicado ? 'oculto' : 'publicado'} />
			{publicado
				? <button class="btn btn-secundario"><EyeOff class="size-4" aria-hidden="true" />Ocultar</button>
				: <button class="btn btn-primario"><Eye class="size-4" aria-hidden="true" />Publicar</button>}
		</form>
		<form method="post">
			<input type="hidden" name="accion" value="duplicar" />
			<button class="btn-icono ring-1 ring-gray-300" title="Duplicar producto" aria-label="Duplicar producto"><Copy class="size-4" aria-hidden="true" /></button>
		</form>
	</Fragment>

	{!publicado && (
		<ul class="flex flex-wrap gap-2">
			{requisitos.map((r) => (
				<li><Insignia color={r.listo ? 'verde' : 'gris'}>{r.listo ? <CircleCheck aria-hidden="true" /> : <CircleDashed aria-hidden="true" />}{r.texto}</Insignia></li>
			))}
		</ul>
	)}

	{/* Orden de trabajo, como en Tiendanube y Shopify: qué es (nombre, descripción), cómo se ve (fotos), cuánto cuesta, qué hay para vender
	    (variantes y stock) y al final lo que ve Google. Cómo se organiza (categoría, colecciones, marca, materiales) va en una columna aparte.
	    El formulario de datos es 'contents': reparte sus tarjetas en la grilla y se guarda todo junto desde la barra. `order-*` es el orden en el celular. */}
	<div class="grid grid-cols-1 items-start gap-5 xl:grid-cols-[minmax(0,1fr)_21rem]">
	<form method="post" class="contents" data-pendiente="Datos" autocomplete="off">
		<input type="hidden" name="accion" value="datos" />
		<Tarjeta titulo="Información" class="order-10 xl:col-start-1">
			<Tag slot="icono" class="size-5 text-gray-400" aria-hidden="true" />
			<DatosProducto parte="basico" p={p} categorias={categorias} colecciones={colecciones} opciones={opciones} cuidados={sugeridos.cuidados} />
		</Tarjeta>
		<Tarjeta titulo="Precio y envío" class="order-20 xl:col-start-1">
			<Banknote slot="icono" class="size-5 text-gray-400" aria-hidden="true" />
			<DatosProducto parte="precio" p={p} categorias={categorias} colecciones={colecciones} opciones={opciones} cuidados={sugeridos.cuidados} />
		</Tarjeta>
		<Tarjeta titulo="Organización" class="order-50 xl:col-start-2 xl:row-start-1 xl:row-span-5">
			<FolderTree slot="icono" class="size-5 text-gray-400" aria-hidden="true" />
			<DatosProducto parte="organizacion" p={p} categorias={categorias} colecciones={colecciones} opciones={opciones} cuidados={sugeridos.cuidados} />
		</Tarjeta>
	</form>

	<Tarjeta titulo="Talles, colores y stock" alRas class="order-40 xl:col-start-1">
		<Layers slot="icono" class="size-5 text-gray-400" aria-hidden="true" />
		<Insignia slot="acciones" color={stockTotal > 0 ? 'azul' : 'rojo'}>{stockTotal} en stock</Insignia>
		{p.variantes.length === 0 ? <Vacio texto="Agregá la primera combinación de talle y color"><Layers aria-hidden="true" /></Vacio> : (
			<div class="relative overflow-x-auto">
				<table class="tabla-tarjetas min-w-full">
					<thead class="border-b border-gray-100">
						<tr><th class="th">Variante</th><th class="th num">Stock</th><th class="th"><span class="sr-only">Acciones</span></th></tr>
					</thead>
					<tbody class="divide-y divide-gray-100">
						{p.variantes.map((v: any) => (
							<tr class:list={[!v.activa && 'bg-gray-50 opacity-70']}>
								<td class="td">
									<span class="flex items-center gap-2 font-medium whitespace-nowrap text-gray-800">
										{v.colorId && <span class="size-4 shrink-0 rounded-full border border-gray-200" style={`background:${colorDe(v.colorId)?.hex ?? 'transparent'}`} aria-hidden="true"></span>}
										{[v.talle, v.color].filter(Boolean).join(' · ') || 'Única'}
									</span>
								</td>
								<td class="td num">
									<form method="post" class="flex items-center justify-end gap-2">
										<input type="hidden" name="accion" value="stock" /><input type="hidden" name="varianteId" value={v.id} /><input type="hidden" name="stockActual" value={v.stock} />
										{!v.activa && <Insignia>Pausada</Insignia>}
										<input name="stockNuevo" type="number" min="0" step="1" inputmode="numeric" value={v.stock} data-stock aria-label={`Stock de ${[v.talle, v.color].filter(Boolean).join(' · ') || 'la variante'}`} class:list={['campo h-9 w-20 px-3 text-right font-semibold', v.stock === 0 && 'border-error-300 text-error-600']} />
									</form>
								</td>
								<td class="td">
									<span class="flex items-center justify-end gap-1">
										<form method="post" data-confirmar-variante={[v.talle, v.color].filter(Boolean).join(' · ') || 'Única'}>
											<input type="hidden" name="accion" value="borrarVariante" /><input type="hidden" name="varianteId" value={v.id} />
											<button class="btn-icono hover:bg-error-50 hover:text-error-600" title="Borrar variante" aria-label="Borrar variante"><Trash2 class="size-5" aria-hidden="true" /></button>
										</form>
										<form method="post">
											<input type="hidden" name="accion" value="activa" /><input type="hidden" name="varianteId" value={v.id} /><input type="hidden" name="valor" value={v.activa ? '0' : '1'} />
											<button class="btn-icono" title={v.activa ? 'Pausar: deja de venderse' : 'Reactivar'} aria-label={v.activa ? 'Pausar: deja de venderse' : 'Reactivar'}>
												{v.activa ? <Pause class="size-5" aria-hidden="true" /> : <Play class="size-5" aria-hidden="true" />}
											</button>
										</form>
									</span>
								</td>
							</tr>
						))}
					</tbody>
				</table>
			</div>
		)}
		<form method="post" class="flex flex-wrap items-end gap-3 border-t border-gray-100 p-5 sm:px-6" data-pendiente="Nueva variante" autocomplete="off">
			<input type="hidden" name="accion" value="variante" />
			<Campo etiqueta="Talle" nombre="talleId" tipo="select" class="min-w-28 flex-1" data-combo data-crear="/api/admin/talles">
				<option value="">Sin talle</option>
				{opciones.talles.map((t) => <option value={t.id}>{t.nombre}</option>)}
			</Campo>
			<Campo etiqueta="Color" nombre="colorId" tipo="select" class="min-w-28 flex-1" data-combo data-crear="/api/admin/colores">
				<option value="">Sin color</option>
				{opciones.colores.map((c) => <option value={c.id} data-hex={c.hex || undefined}>{c.nombre}</option>)}
			</Campo>
			<Campo etiqueta="Stock" nombre="stock" inputmode="numeric" valor="0" class="w-24" />
			<button class="btn btn-secundario"><Plus class="size-4" aria-hidden="true" />Agregar</button>
		</form>
	</Tarjeta>

	{verMovimientos && (
		<Tarjeta titulo="Historial de stock" alRas id="movimientos" class="order-[45] xl:col-start-1">
			<History slot="icono" class="size-5 text-gray-400" aria-hidden="true" />
			<div class="relative overflow-x-auto">
				<table class="min-w-full">
					<tbody class="divide-y divide-gray-100">
						{movimientos.map((m) => (
							<tr>
								<td class="td"><span class="font-medium text-gray-800">{MOVIMIENTOS[m.tipo]}</span>{m.pedido_id && <> · <a href={`/admin/pedidos/${m.pedido_id}`} class="text-brand-500 hover:underline">ver pedido</a></>}<br /><span class="text-theme-xs text-gray-500">{fecha(m.creado_en)}{m.nota ? ` · ${m.nota}` : ''}</span></td>
								<td class="td num"><Insignia color={m.cantidad > 0 ? 'verde' : 'rojo'}>{m.cantidad > 0 ? `+${m.cantidad}` : m.cantidad}</Insignia></td>
							</tr>
						))}
					</tbody>
				</table>
			</div>
		</Tarjeta>
	)}

	<Tarjeta titulo="Fotos" class="order-30 xl:col-start-1">
		<Camera slot="icono" class="size-5 text-gray-400" aria-hidden="true" />
		{p.imagenes.length > 1 && <p class="text-theme-xs mb-3 text-gray-500" role="status" data-estado-fotos>Arrastrá las fotos para ordenarlas: la primera es la principal.</p>}
		<div data-fotos={`/api/admin/productos/${id}/imagenes/orden`} class="grid grid-cols-2 gap-4 sm:grid-cols-3 lg:grid-cols-5">
			{p.imagenes.map((img: any, i: number) => (
				<figure data-id={img.id} class="group relative rounded-xl bg-white">
					{p.imagenes.length > 1 && (
						<button type="button" data-asa class="shadow-theme-sm absolute top-2 left-2 z-[1] flex size-9 cursor-grab touch-none items-center justify-center rounded-lg bg-white/90 text-gray-600 hover:bg-white active:cursor-grabbing" title="Arrastrar para ordenar" aria-label={`Ordenar la foto ${i + 1}: arrastrá o usá las flechas`}>
							<GripVertical class="size-5" aria-hidden="true" />
						</button>
					)}
					{i === 0 && <span data-principal class="text-theme-xs absolute top-2 right-2 z-[1] rounded-full bg-gray-900/80 px-2 py-0.5 font-medium text-white">Principal</span>}
					{/* Tocar la foto abre el recorte (scripts/reencuadrar-foto.ts). Es un div y no un botón para que se pueda seguir arrastrando de ahí. */}
					<div role="button" tabindex="0" data-recortar={img.id} data-clave={img.clave} data-original={img.original ? '1' : '0'} data-encuadre={img.encuadre ?? ''} title="Reencuadrar la foto" aria-label={`Reencuadrar la foto ${i + 1}`} class="group/foto relative block cursor-pointer overflow-hidden rounded-xl">
						<img src={foto(img.clave, 'mediano')} alt={`${p.nombre}${colorDe(img.colorId) ? ` ${colorDe(img.colorId).nombre}` : ''}`} loading="lazy" class="aspect-[3/4] w-full bg-gray-100 object-cover" />
						<span class="absolute inset-0 flex items-center justify-center bg-gray-900/45 text-sm font-medium text-white opacity-0 transition group-hover/foto:opacity-100 group-focus-visible/foto:opacity-100"><Crop class="mr-1.5 size-4" aria-hidden="true" />Reencuadrar</span>
					</div>
					<figcaption class="mt-1.5 flex items-center justify-between gap-1">
						<details class="relative min-w-0">
							<summary class="text-theme-xs flex min-w-0 cursor-pointer list-none items-center gap-1.5 text-gray-500 hover:text-gray-800 hover:underline [&::-webkit-details-marker]:hidden" title="Cambiar el color de esta foto">
								{img.colorId && <span class="size-3 shrink-0 rounded-full border border-gray-200" style={`background:${colorDe(img.colorId)?.hex ?? 'transparent'}`} aria-hidden="true"></span>}
								<span class="truncate">{colorDe(img.colorId)?.nombre ?? 'General'}</span>
							</summary>
							<form method="post" class="shadow-theme-lg absolute left-0 bottom-8 z-10 w-60 space-y-3 rounded-xl border border-gray-200 bg-white p-4" data-pendiente={`Foto ${i + 1}`} autocomplete="off">
									<input type="hidden" name="accion" value="foto" /><input type="hidden" name="imagenId" value={img.id} />
									<Campo etiqueta="Color del producto" nombre="colorId" tipo="select">
										<option value="">General</option>
										{opcionesFoto(img.colorId).map((v) => <option value={v.id} selected={v.id === img.colorId}>{v.texto}</option>)}
									</Campo>
								</form>
						</details>
						<span class="flex shrink-0">
							{/* Borrar pide confirmación, como en la lista de productos: el tacho abre un segundo botón. */}
							<details class="group flex items-center">
								<summary class="btn-icono hover:bg-error-50 hover:text-error-600 size-8 group-open:hidden" title="Borrar foto" aria-label={`Borrar la foto ${i + 1}`}><Trash2 class="size-4" aria-hidden="true" /></summary>
								<form method="post">
									<input type="hidden" name="accion" value="borrarFoto" /><input type="hidden" name="imagenId" value={img.id} />
									<button class="btn btn-peligro px-2.5 py-1.5"><Trash2 class="size-4" aria-hidden="true" />¿Borrar?</button>
								</form>
							</details>
						</span>
					</figcaption>
				</figure>
			))}
		</div>

		<form data-subida={`/api/admin/productos/${id}/imagenes`} data-auto data-aspecto={3 / 4} data-guardar-original="2000" data-tamanos='{"chico":400,"mediano":900,"grande":1600}' class:list={['space-y-4', p.imagenes.length > 0 && 'mt-6 border-t border-gray-100 pt-6']}>
			<Campo etiqueta="Color del producto" nombre="colorId" tipo="select" ayuda="Elegilo antes de subir. Son los colores que cargaste en las variantes: la foto se muestra cuando la clienta elige ese color. «General» se ve siempre. La descripción de la foto se arma sola con el nombre del producto y el color.">
				<option value="">General</option>
				{variantesParaFoto.map((v) => <option value={v.id}>{v.texto}</option>)}
			</Campo>
			{variantesParaFoto.length === 0 && <p class="text-theme-xs -mt-2 text-gray-500">Este producto todavía no tiene variantes con color. Creá las variantes arriba para poder asignarles fotos.</p>}
		<label class="hover:border-brand-300 hover:bg-brand-25 flex cursor-pointer flex-col items-center gap-2 rounded-xl border-2 border-dashed border-gray-300 bg-gray-50 px-4 py-8 text-center transition" data-zona>
			<ImagePlus class="size-8 text-gray-400" aria-hidden="true" />
			<span class="text-sm font-medium text-gray-700">Elegir fotos o arrastrarlas hasta acá</span>
			<span class="text-theme-xs text-gray-500">Se suben solas apenas las elegís.</span>
			<input type="file" name="foto" accept="image/*" multiple required class="sr-only" />
		</label>
		<p data-estado class="text-theme-xs text-gray-500" role="status"></p>
		</form>
	</Tarjeta>
	<Tarjeta titulo="Buscadores y redes" class="order-60 xl:col-start-1">
		<Search slot="icono" class="size-5 text-gray-400" aria-hidden="true" />
		<form method="post" data-pendiente="Buscadores" autocomplete="off">
			<input type="hidden" name="accion" value="seo" />
			<SeoCampos ruta="producto" slug={p.slug} titulo={p.seoTitulo} descripcion={p.seoDescripcion} tituloAuto={p.nombre} descripcionAuto={descripcionAutomatica} fotos={p.imagenes.map((i: any) => i.clave)} imagen={p.seoImagen} />
		</form>
	</Tarjeta>
	</div>
	<BarraGuardado />
</Panel>

<script src="../../../scripts/fotos.ts"></script>
<script src="../../../scripts/ordenar-fotos.ts"></script>
