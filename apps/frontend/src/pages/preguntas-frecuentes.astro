---
import { ChevronDown } from '@lucide/astro';
import TextoConFormato from '../components/tienda/TextoConFormato.astro';
import Tienda from '../layouts/Tienda.astro';
import { bloquesDe, textoDe } from '../lib/textos';
import { datosDeLaTienda, jsonLd } from '../lib/tienda';

export const prerender = false;

const { tienda } = await datosDeLaTienda(Astro.request);
// Lo cargado en el panel o, si no hay nada, las preguntas originales (lib/textos.ts).
const preguntas = textoDe('contenido_preguntas_frecuentes', tienda.contenido);
// Para Google, la respuesta va en texto plano, con los datos de Configuración ya puestos.
const textoPlano = (respuesta: string) =>
	bloquesDe(respuesta, tienda)
		.flatMap((b) => (b.tipo === 'titulo' ? [b.partes] : b.tipo === 'lista' ? b.items : b.lineas))
		.map((partes) => partes.map((p) => p.texto).join(''))
		.join(' ');
const datosEstructurados = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	mainEntity: preguntas.map((q) => ({ '@type': 'Question', name: q.pregunta, acceptedAnswer: { '@type': 'Answer', text: textoPlano(q.respuesta) } })),
};
---

<Tienda titulo="Preguntas frecuentes" descripcion="Envíos, pagos, talles y cambios: respondemos lo que más nos preguntan.">
	<div class="contenedor max-w-2xl py-8 md:py-12">
		<h1 class="mb-6 text-2xl md:text-3xl">Preguntas frecuentes</h1>
		{
			preguntas.length ? (
				<div class="divide-linea border-linea divide-y border-y">
					{preguntas.map((q) => (
						<details class="group py-1">
							<summary class="flex min-h-12 cursor-pointer list-none items-center justify-between gap-4 py-2 font-medium [&::-webkit-details-marker]:hidden">
								{q.pregunta}
								<ChevronDown class="size-5 shrink-0 transition-transform group-open:rotate-180" aria-hidden="true" />
							</summary>
							<TextoConFormato class="text-suave pb-4 text-sm" texto={q.respuesta} tienda={tienda} />
						</details>
					))}
				</div>
			) : (
				<p class="text-suave">Todavía no cargamos las preguntas. Si tenés dudas, <a href="/contacto" class="underline">escribinos</a>.</p>
			)
		}
	</div>
	{preguntas.length > 0 && <script type="application/ld+json" set:html={jsonLd(datosEstructurados)} />}
</Tienda>
