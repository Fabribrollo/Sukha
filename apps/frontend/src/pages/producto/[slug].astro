---
import FichaProducto from '../../components/tienda/FichaProducto.tsx';
import Migas from '../../components/tienda/Migas.astro';
import TarjetaProducto from '../../components/tienda/TarjetaProducto.astro';
import Tienda from '../../layouts/Tienda.astro';
import { api } from '../../lib/api';
import { canonica, datosDeLaTienda, jsonLd, parrafos, precioFinal, urlFoto, type FichaDeProducto } from '../../lib/tienda';

export const prerender = false;

// Los datos de la tienda se piden a la vez que el producto, no después.
const datosTienda = datosDeLaTienda(Astro.request);
const respuesta = await api(Astro.request, `/api/catalogo/productos/${encodeURIComponent(Astro.params.slug!)}`);
if (respuesta.status === 404) return Astro.rewrite('/404');
// Cualquier otro error (backend caído, límite…) termina en la página de error amable (pages/500.astro).
if (!respuesta.ok) throw new Error(`${Astro.url.pathname}: ${respuesta.status}`);
const p = (await respuesta.json()) as FichaDeProducto;
const { tienda } = await datosTienda;

const solicitada = Number(Astro.url.searchParams.get('variante'));
const varianteInicial = p.variantes.some((v) => v.id === solicitada) ? solicitada : null;
const url = canonica(Astro.url);
const descripcion = p.seoDescripcion || (p.descripcion ?? '').replace(/\s+/g, ' ').trim().slice(0, 155) || `${p.nombre} en Sukhä. Envíos a todo el país.`;
const primera = p.seoImagen || p.imagenes[0]?.clave;
const hayStock = p.variantes.some((v) => v.stock > 0);
const origen = Astro.url.origin;
const datosEstructurados = {
  '@context': 'https://schema.org',
  '@type': 'Product',
  name: p.nombre,
  description: descripcion,
  image: p.imagenes.map((i) => new URL(urlFoto(i.clave, 'grande'), origen).toString()),
  brand: { '@type': 'Brand', name: 'Sukhä' },
  offers: {
    '@type': 'Offer',
    url,
    priceCurrency: 'ARS',
    price: (precioFinal(p) / 100).toFixed(2),
    availability: hayStock ? 'https://schema.org/InStock' : 'https://schema.org/OutOfStock',
  },
};
// A la isla solo le pasamos lo que usa: no hace falta mandar al navegador los textos de la tienda.
const { descuentoTransferenciaPorcentaje, cuotasSinInteres, reservaMercadoPagoMinutos, reservaTransferenciaHoras, retiro, ultimasUnidadesUmbral, maxUnidadesPorPedido, whatsapp } = tienda;
const datosParaLaFicha = { descuentoTransferenciaPorcentaje, cuotasSinInteres, reservaMercadoPagoMinutos, reservaTransferenciaHoras, retiro, ultimasUnidadesUmbral, maxUnidadesPorPedido, whatsapp };
const cambios = parrafos(tienda.contenido.contenido_politica_cambios);
const secciones = [
  { titulo: 'Cambios', abierta: false, parrafos: cambios.slice(0, 2), enlace: cambios.length ? { href: '/cambios-y-devoluciones', texto: 'Ver la política completa' } : undefined },
].filter((s) => s.parrafos.length > 0);
---

<Tienda titulo={p.seoTitulo || p.nombre} descripcion={descripcion} imagen={primera ? urlFoto(primera, 'grande') : undefined} canonica={url} tipo="product">
	<script type="application/ld+json" set:html={jsonLd(datosEstructurados)} slot="head" />
	<div class="contenedor pt-0 pb-4 md:pt-6">
		<div hidden><Migas items={[...(p.categoriaPadre ? [{ texto: p.categoriaPadre.nombre, href: `/categoria/${p.categoriaPadre.slug}` }] : []), { texto: p.categoria, href: `/categoria/${p.categoriaSlug}` }, { texto: p.nombre }]} /></div>
		<div class="md:mt-5">
			<FichaProducto client:load producto={p} tienda={datosParaLaFicha} varianteInicial={varianteInicial} url={url} secciones={secciones} />
		</div>

		{p.relacionados.length > 0 && (
			<section class="mt-16 md:mt-24" aria-labelledby="sec-relacionados">
				<h2 id="sec-relacionados" class="mb-6 text-3xl md:mb-8 md:text-[44px] md:leading-tight">Completá el look</h2>
				<ul class="fila-deslizable md:grid md:grid-cols-4 md:gap-4 md:overflow-visible">
					{p.relacionados.slice(0, 4).map((r) => <li class="w-[150px] shrink-0 snap-start md:w-auto"><TarjetaProducto producto={r} tienda={tienda} /></li>)}
				</ul>
			</section>
		)}
	</div>
</Tienda>
